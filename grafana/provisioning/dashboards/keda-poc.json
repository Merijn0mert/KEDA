{
  "title": "KEDA PoC - Job Queue Dashboard",
  "uid": "keda-poc-main",
  "schemaVersion": 38,
  "time": { "from": "now-10m", "to": "now" },
  "refresh": "5s",
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Queue lengte",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "rabbitmq_queue_length", "datasource": "Prometheus" }],
      "options": { "colorMode": "background", "graphMode": "area" },
      "fieldConfig": { "defaults": { "thresholds": {
        "steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 10}, {"color": "red", "value": 50}]
      }}}
    },
    {
      "id": 2, "type": "stat", "title": "Totaal verwerkte jobs",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "sum(worker_jobs_processed_total)", "datasource": "Prometheus" }],
      "options": { "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" } } }
    },
    {
      "id": 3, "type": "stat", "title": "Totaal gepubliceerde jobs",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "jobs_published_total", "datasource": "Prometheus" }],
      "options": { "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "purple" } } }
    },
    {
      "id": 4, "type": "stat", "title": "Actieve workers",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "sum(worker_active_jobs)", "datasource": "Prometheus" }],
      "options": { "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "thresholds": {
        "steps": [{"color": "green", "value": 0}, {"color": "blue", "value": 1}]
      }}}
    },
    {
      "id": 5, "type": "timeseries", "title": "Queue lengte over tijd",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "rabbitmq_queue_length", "legendFormat": "Queue lengte", "datasource": "Prometheus" },
        { "expr": "sum(worker_active_jobs)", "legendFormat": "Actieve workers", "datasource": "Prometheus" }
      ],
      "fieldConfig": { "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 10 } } }
    },
    {
      "id": 6, "type": "timeseries", "title": "Verwerkingstijd per job (p50 / p95)",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(worker_job_processing_duration_seconds_bucket[1m]))", "legendFormat": "p50", "datasource": "Prometheus" },
        { "expr": "histogram_quantile(0.95, rate(worker_job_processing_duration_seconds_bucket[1m]))", "legendFormat": "p95", "datasource": "Prometheus" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 2 } } }
    },
    {
      "id": 7, "type": "timeseries", "title": "Wachttijd in queue (p50 / p95)",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(worker_job_queue_wait_seconds_bucket[1m]))", "legendFormat": "p50 wachttijd", "datasource": "Prometheus" },
        { "expr": "histogram_quantile(0.95, rate(worker_job_queue_wait_seconds_bucket[1m]))", "legendFormat": "p95 wachttijd", "datasource": "Prometheus" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 2 } } }
    },
    {
      "id": 8, "type": "timeseries", "title": "Jobs gepubliceerd per seconde",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [
        { "expr": "rate(jobs_published_total[30s])", "legendFormat": "Publish rate", "datasource": "Prometheus" },
        { "expr": "sum(rate(worker_jobs_processed_total[30s]))", "legendFormat": "Verwerkingsrate", "datasource": "Prometheus" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineWidth": 2 } } }
    }
  ]
}
